{
  "name": "civicsync",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:all": "concurrently -n \"API,WEB\" -c \"cyan,blue\" \"npm run backend\" \"npm run dev\"",
    "dev": "next dev -p 3000",
    "backend": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 5000 --reload",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "python -m pytest tests/test_civicsync.py -v"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "^4.7.1",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
