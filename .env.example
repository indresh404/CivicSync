# DigSync Environment Configuration

# Backend Port (FastAPI)
PORT=5000

# Frontend Next.js API Target
NEXT_PUBLIC_API_URL=http://localhost:5000
# OpenFreeMap Vector Map Style (Free, No Key, OSM Roads & Footprints)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.up2l13c.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=digsync

# Authentication JWT Secret
JWT_SECRET=mySuperSecretKey

# Business Rules Engine Parameters
CONFLICT_THRESHOLD_METERS=50.0
ASSUMED_COST_PER_REDIG=350000.0
COOLDOWN_MONTHS=24
MONSOON_START=06-01
MONSOON_END=09-30

# Optional PostgreSQL database (if omitted, falls back seamlessly to SQLite civicsync.db)
DATABASE_URL=
