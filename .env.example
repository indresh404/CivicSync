# CivicSync Environment Configuration
# Frontend API URL (points to FastAPI backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend Database URL:
# For production PostgreSQL: postgresql://username:password@localhost:5432/civicsync
# If omitted or left empty, the backend automatically uses deterministic SQLite local demo mode (civicsync.db)
DATABASE_URL=

# Distance threshold in meters for spatial conflict detection (default: 50.0)
CONFLICT_THRESHOLD_METERS=50.0

# Illustrative average municipal cost per prevented repeat excavation (default: $45,000)
ASSUMED_COST_PER_REDIG=45000.0
