# ==============================================================================
# CIVICSYNC — PRODUCTION-READY ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to:
#   - `.env.local` for local development
#   - `.env` on production servers (Railway, Render, Fly.io, Docker, VPS)
#   - Set the `NEXT_PUBLIC_*` variables in Vercel / Netlify dashboard for frontend
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND NEXT.JS CONFIGURATION (Used by Web Client)
# ------------------------------------------------------------------------------
# Production: Set to your public backend API URL (e.g., https://api.civicsync.yourdomain.com)
# Local: http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# OpenFreeMap Vector Map Style (Free, open-source, no API key required)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Supabase Client Public Credentials (Used by frontend auth / real-time listeners)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key

# Groq Cloud API Key for Frontend AI Assistant (Optional, falls back to server-side)
NEXT_PUBLIC_GROQ_API_KEY=

# Hugging Face Token for GenCity 3D Studio Client (Optional)
NEXT_PUBLIC_HF_TOKEN=

# Google Gemini API Key for Frontend AI Copilot (Optional)
NEXT_PUBLIC_GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. BACKEND FASTAPI CONFIGURATION (Used by Python Server)
# ------------------------------------------------------------------------------
# Port for FastAPI uvicorn server (Default: 5000)
PORT=5000

# Environment Mode ('development' | 'production' | 'test')
ENVIRONMENT=production

# JWT Authentication Secret Key (Generate a secure 64-char string in production)
JWT_SECRET=CivicSync2026SecureProductionSecretKey!ChangeInProduction

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Supabase PostgreSQL / SQLite Fallback)
# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection String (Pooler with IPv4 support recommended for clouds)
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Project Credentials (Server-side)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Optional MongoDB Connection (if using MongoDB storage)
MONGO_URI=
MONGO_DB_NAME=civicsync

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE & 3D DIGITAL TWIN SERVICES
# ------------------------------------------------------------------------------
# Groq AI Cloud API Key (Powers ultra-fast LLaMA-3.3 70B spatial clash analysis)
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face Inference API Token (Powers GenCity 3D / TRELLIS / Stable Fast 3D)
HF_TOKEN=your_huggingface_token_here

# Google Gemini AI Key (Optional secondary LLM fallback)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. CIVICSYNC MUNICIPAL SPATIAL CONFLICT ENGINE PARAMETERS
# ------------------------------------------------------------------------------
# Proximity detection radius in meters (Default: 50.0m)
CONFLICT_THRESHOLD_METERS=50.0

# Estimated municipal cost penalty per uncoordinated road re-excavation (in INR)
ASSUMED_COST_PER_REDIG=350000.0

# Mandatory post-resurfacing road trenching moratorium/cooldown period in months
COOLDOWN_MONTHS=24

# Monsoon civic construction ban window (MM-DD format)
MONSOON_START=06-01
MONSOON_END=09-30
