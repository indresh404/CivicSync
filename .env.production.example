# ==============================================================================
# CIVICSYNC — PRODUCTION DEPLOYMENT GUIDE & ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION A: DEPLOYING TO VERCEL (FRONTEND)
# Add these Environment Variables in your Vercel Project Settings > Environment Variables:
# ------------------------------------------------------------------------------
# 1. Target URL of your deployed FastAPI backend (e.g., Railway/Render URL):
NEXT_PUBLIC_API_URL=https://api.civicsync.yourdomain.com

# 2. Free Open-source Vector Map Tiles (Zero API key needed):
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# 3. Supabase Client Configuration:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key

# 4. AI & 3D Studio Client Configuration:
NEXT_PUBLIC_GROQ_API_KEY=your_groq_api_key_here
NEXT_PUBLIC_HF_TOKEN=your_huggingface_token_here
NEXT_PUBLIC_GOOGLE_3D_TILES_KEY=your_google_maps_3d_tiles_api_key_here

# ------------------------------------------------------------------------------
# OPTION B: DEPLOYING TO RAILWAY / RENDER / DOCKER (FASTAPI BACKEND)
# Add these Environment Variables in your Backend Service dashboard:
# ------------------------------------------------------------------------------
PORT=5000
ENVIRONMENT=production
JWT_SECRET=CivicSync2026SecureProductionSecretKey!ChangeInProduction

# Manus AI Agent API V2 Configuration:
MANUS_API_KEY=your_manus_api_key_here
MANUS_API_BASE_URL=https://api.manus.ai
MANUS_WEBHOOK_SECRET=your_webhook_secret_here

# Database: Supabase PostgreSQL Connection Pooler (supports IPv4 out of the box)
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# AI Acceleration Keys:
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here

# Municipal Conflict Parameters:
CONFLICT_THRESHOLD_METERS=50.0
ASSUMED_COST_PER_REDIG=350000.0
COOLDOWN_MONTHS=24
MONSOON_START=06-01
MONSOON_END=09-30
