# CivicSync FastAPI Backend Environment Configuration Example

PORT=5000
JWT_SECRET=CivicSync2026SecureKeySecret!

# Conflict Engine Business Rules
CONFLICT_THRESHOLD_METERS=50.0
ASSUMED_COST_PER_REDIG=350000.0
COOLDOWN_MONTHS=24
MONSOON_START=06-01
MONSOON_END=09-30

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=civicsync

# Optional Database URL (Postgres / SQLite)
# If left empty, CivicSync automatically uses persistent SQLite (backend/civicsync.db)
DATABASE_URL=
