# ==============================================================================
# CIVICSYNC FASTAPI BACKEND — DEPLOYMENT ENVIRONMENT VARIABLES
# ==============================================================================

# Server Port (Render/Railway/Heroku auto-injects PORT if not set)
PORT=5000
ENVIRONMENT=production

# JWT Authentication
JWT_SECRET=CivicSync2026SecureProductionSecretKey!ChangeInProduction

# Database: Supabase PostgreSQL (IPv4 Pooler recommended for serverless/cloud containers)
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Optional MongoDB connection (if using MongoDB)
MONGO_URI=
MONGO_DB_NAME=civicsync

# AI Cloud Keys (Groq Cloud ultra-fast inference + Hugging Face 3D inference)
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here
GEMINI_API_KEY=

# Civic Spatial Engine Parameters
CONFLICT_THRESHOLD_METERS=50.0
ASSUMED_COST_PER_REDIG=350000.0
COOLDOWN_MONTHS=24
MONSOON_START=06-01
MONSOON_END=09-30
